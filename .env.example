# Copy to .env locally. Never commit secrets or Zigbee network credentials.
OPENHOME_HOST=127.0.0.1
OPENHOME_PORT=3000
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
ZIGBEE2MQTT_BASE_TOPIC=zigbee2mqtt
# Linux example: /dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_V2-if00-port0
# macOS example: /dev/cu.usbserial-210
# Windows example: COM5 (container USB passthrough may not support this directly)
ZIGBEE_SERIAL_PORT=
ZIGBEE_ADAPTER=ember
